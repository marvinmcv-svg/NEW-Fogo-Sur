# Copy to .env (local) or set in Vercel → Project → Settings → Environment Variables.

# Long random string. Signs admin sessions. REQUIRED in production.
PAYLOAD_SECRET=

# Local: leave empty to use SQLite (./fogo.db).
# Production: a Postgres URL (Supabase / Neon), e.g. postgres://user:pass@host:5432/db
DATABASE_URI=

# Production media storage (Vercel Blob). Leave empty locally (files go to ./media).
BLOB_READ_WRITE_TOKEN=

# Public URL of the site, used for SEO (canonical, hreflang, sitemap, OG).
NEXT_PUBLIC_SERVER_URL=https://www.example.com

# First admin created by `npm run seed` (only if no users exist yet).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
